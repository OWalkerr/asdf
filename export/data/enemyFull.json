"function makeEnemyFull(type, x, y, elite) {\n  const e = makeEnemy(type, x, y), r = G.room;\n  if (e.boss) { e.kind = bossKind(r); e.name = bossName(r); e.t = 1.2; if (e.kind === 'rider') { e.spd *= 1.3; e.r = 40; e.hp *= .9; e.maxHp = e.hp; } if (e.kind === 'queen') { e.r = 38; e.spd *= 1.1; e.hp *= .95; e.maxHp = e.hp; e.fade = 1; }\n    if (e.kind === 'cardinal') { e.r = 40; e.spd *= .85; }\n    if (e.kind === 'treant') { e.r = 48; e.spd *= .7; e.hp *= 1.15; e.maxHp = e.hp; }\n    if ((Math.floor(r / 5) >= 4 || vowLv('wrath')) && e.kind !== 'moon') { e.asc = true; e.name = 'Yükselmiş ' + e.name; e.hp *= 1.2; e.maxHp = e.hp; }\n    if (e.kind === 'moon') { e.r = 54; e.spd *= .9; e.hp *= 1.9; e.maxHp = e.hp; e.phase = 1; e.bA = 0; } }\n  if (elite) {\n    e.elite = ['shield', 'swift', 'burst'][Math.floor(crand() * 3)];\n    e.hp *= 1.8; e.maxHp = e.hp; e.r *= 1.2; e.dmg *= 1.2;\n    if (e.elite === 'swift') e.spd *= 1.35; if (e.elite === 'shield') e.shield = e.maxHp * .4;\n  }\n  if (e.type === 'knight') e.ang = Math.atan2(G.p.y - y, G.p.x - x);\n  if (G.roomType === 'cursed') e.spd *= 1.15;\n  e.spd *= G.mod.spd || 1;\n  return e;\n}"