"function roomWaves(r) {\n  const pool = ['ghoul', 'ghoul', 'wisp'];\n  if (r >= 2) pool.push('archer'); if (r >= 3) pool.push('brute'); if (r >= 4) pool.push('spitter');\n  if (r >= 6) pool.push('bomb'); if (r >= 7) pool.push('knight');\n  if (r >= 10 && r < 20) pool.push('frost', 'frost'); if (r >= 20 && r < 30) pool.push('bat', 'bat'); if (r >= 30) pool.push('thorn', 'thorn', 'thorn', 'thorn', 'sporer', 'sporer', 'sporer', 'wolf', 'wolf', 'wolf', 'bat');\n  if (r >= 7) pool.push('archer', 'brute', 'spitter'); if (r >= 9) pool.push('knight', 'bomb');\n  const cost = { ghoul: 1, wisp: 1.2, archer: 1.5, brute: 3, spitter: 2.5, knight: 2.5, bomb: 1.4, frost: 1.3, bat: 1.1, thorn: 1.8, sporer: 2.4, wolf: 1.4 };\n  const n = 2 + (r >= 3) + (r >= 14);\n  const waves = [];\n  for (let i = 0; i < n; i++) {\n    let b = (4.5 + r * 1.5 + i * 1.5) * 1.3 * (1 + .2 * vowLv('crowd')); const w = [];\n    while (b > 0) { const t = pool[Math.floor(crand() * pool.length)]; if (t === 'wisp') w.push('wisp', 'wisp', 'wisp'); else if (t === 'bomb') w.push('bomb', 'bomb'); else if (t === 'bat') w.push('bat', 'bat', 'bat'); else if (t === 'wolf') w.push('wolf', 'wolf'); else w.push(t); b -= cost[t]; }\n    waves.push(w);\n  }\n  return waves;\n}"