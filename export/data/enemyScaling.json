"function makeEnemy(type, x, y, elite) {\n  const d = EDEF[type], r = G.room, hm = 1 + .17 * Math.min(r - 1, 9) + .1 * Math.max(0, r - 10) + .12 * Math.max(0, r - 20), tier = Math.floor(r / 5);\n  // regular enemies are frailer but come in bigger, faster waves: rooms last ~30-45 s instead of 60-100\n  const hp = type === 'boss' ? d.hp * (1 + .6 * (tier - 1)) * (1 + .05 * r) : d.hp * hm * .72;\n  const vh = 1 + .2 * vowLv('bone') * (type === 'boss' ? .5 : 1), vs = 1 + .15 * vowLv('fast');\n  return { type, x, y, r: d.r, hp: hp * vh, maxHp: hp * vh, spd: d.spd * (1 + .015 * r) * vs, dmg: d.dmg * (1 + .08 * (r - 1)), stacks: 0, stackT: 0, slowT: 0, slowAmt: 0,\n    flash: 0, kx: 0, ky: 0, cd: rand(1, 2.5), st: 'walk', t: 0, ax: 0, ay: 0, wob: rand(0, TAU), trailCd: 0, boss: type === 'boss', dead: false, ang: 0, n: 0,\n    stunT: 0, shield: 0, elite: null };\n}"