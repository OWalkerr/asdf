{
  "name": "bulwark",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @bulwark/client dev",
    "build": "pnpm --filter @bulwark/client build",
    "preview": "pnpm --filter @bulwark/client preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "shot": "node tests/e2e/shot.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
